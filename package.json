{
  "devDependencies": {
    "concurrently": "^9.2.0",
    "live-server": "^1.2.2",
    "sass": "^1.89.2"
  },
  "scripts": {
    "dev": "concurrently \"npm run watch:css\" \"npm run serve\"",
    "serve": "live-server",
    "build:css": "npm run build:css:normal && npm run build:css:min",
    "build:css:normal": "sass assets/scss/scss-master:assets/css/master --style=expanded",
    "build:css:min": "sass assets/scss/scss-master:assets/css/master --style=compressed",
    "watch:css": "concurrently \"npm run watch:css:normal\" \"npm run watch:css:min\"",
    "watch:css:normal": "sass assets/scss/scss-master:assets/css/master --style=expanded --watch",
    "watch:css:min": "sass assets/scss/scss-master:assets/css/master --style=compressed --watch"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^5.15.4",
    "bootstrap": "^5.0.2",
    "flickity": "^3.0.0",
    "mouse-follower": "^1.1.2",
    "select2": "^4.1.0-rc.0"
  }
}
